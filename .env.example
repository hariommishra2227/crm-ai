# Zoho India data centre. Use the api_domain returned by OAuth if different.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_CLIENT_ID=replace_me
ZOHO_CLIENT_SECRET=replace_me
ZOHO_REFRESH_TOKEN=replace_me

# Confirm these API names in Setup > Developer Hub > APIs & SDKs > API Names.
ZOHO_ACCOUNTS_MODULE=Accounts
ZOHO_DEALS_MODULE=Deals
ZOHO_ALERTS_MODULE=CRM_Alert
# Verify these related-list API names in Zoho CRM metadata for your org.
ZOHO_ACCOUNT_DEALS_RELATED_LIST=Deals
ZOHO_ACCOUNT_QUOTES_RELATED_LIST=Quotes
ZOHO_DEAL_QUOTES_RELATED_LIST=Quotes
STALE_ACCOUNT_DAYS=30
STALE_DEAL_DAYS=21
# Pydantic parses complex environment values as JSON.
REQUIRED_ACCOUNT_PROFILE_FIELDS=["Account_Name","Phone","Website","Industry","Billing_City","Billing_State","Billing_Country"]
ALERT_NAME_FIELD=Name
ALERT_CATEGORY_FIELD=Category
ALERT_ACCOUNT_FIELD=Account
ALERT_DEAL_FIELD=Deal
ALERT_RESPONSIBLE_OWNER_FIELD=Owner
ALERT_INACTIVE_DAYS_FIELD=Inactive_Days
ALERT_SEVERITY_FIELD=Severity
ALERT_STATUS_FIELD=Status
ALERT_RECOMMENDED_ACTION_FIELD=Recommended_Action
ALERT_GENERATED_ON_FIELD=Generated_On
ALERT_UNIQUE_KEY_FIELD=Unique_Key
# Optional Zoho fields. Leave blank unless these API fields exist in your org.
ALERT_DESCRIPTION_FIELD=
ALERT_RESOLVED_ON_FIELD=
ALERT_DAYS_OPEN_FIELD=

DATABASE_URL=sqlite:///./crm_intelligence.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/crm_intelligence
SCHEDULE_ENABLED=false
SCHEDULE_HOUR_IST=8
